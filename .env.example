# Optional overrides. Compose already supplies these defaults.
PX4_SIM_MODEL=gz_x500
PX4_GZ_WORLD=default
PX4_SIM_SPEED_FACTOR=1
DRN_GPU_MODE=auto
# x500-multi only; the supported bounded range is 2 through 4.
DRN_FLEET_SIZE=2
ROS_DOMAIN_ID=0
FOXGLOVE_HOST=127.0.0.1
FOXGLOVE_PORT=8765
QGC_HOST=host.docker.internal
QGC_PORT=14550

# Real hardware is explicit and uses a trusted, non-loopback bench interface.
# DRN_HARDWARE_BIND_ADDRESS=10.41.10.1
# DRN_HARDWARE_MAVLINK_PORT=14580
