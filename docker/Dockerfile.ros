FROM ros:humble-ros-base-jammy AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PX4_MSGS_REF=35a005a86b82cae28bd7a2eb58c4bb7a840830c9
ARG PX4_ROS_COM_REF=86e9aeb20e55a4673fa8a9f1c29ea06a6c5ad1af
ARG PX4_ROS2_INTERFACE_REF=4a3370f084ac6f1ef001a4afa2b007845ffd0837
ARG MICRO_XRCE_DDS_AGENT_REF=73622810d984349b80bbac0ef55fc0b694d62222
ARG BUILD_JOBS=4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libasio-dev \
        libeigen3-dev \
        libtinyxml2-dev \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN git clone https://github.com/eProsima/Micro-XRCE-DDS-Agent.git \
    && cd Micro-XRCE-DDS-Agent \
    && git checkout "${MICRO_XRCE_DDS_AGENT_REF}" \
    && mkdir build \
    && cd build \
    && cmake -DCMAKE_BUILD_TYPE=Release .. \
    && cmake --build . --parallel "${BUILD_JOBS}" \
    && cmake --install .

WORKDIR /opt/drn_ws/src
RUN git clone https://github.com/PX4/px4_msgs.git \
    && cd px4_msgs \
    && git checkout "${PX4_MSGS_REF}"
RUN git clone https://github.com/PX4/px4_ros_com.git \
    && cd px4_ros_com \
    && git checkout "${PX4_ROS_COM_REF}"
RUN git clone https://github.com/Auterion/px4-ros2-interface-lib.git \
    && cd px4-ros2-interface-lib \
    && git checkout "${PX4_ROS2_INTERFACE_REF}" \
    && touch examples/COLCON_IGNORE

COPY src/drn_control /opt/drn_ws/src/drn_control
COPY src/drn_viz /opt/drn_ws/src/drn_viz

WORKDIR /opt/drn_ws
RUN . /opt/ros/humble/setup.sh \
    && rosdep update \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src --rosdistro humble -r -y \
        --skip-keys ros_gz_bridge \
    && colcon build --merge-install --parallel-workers 2 --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf /var/lib/apt/lists/*

FROM ros:humble-ros-base-jammy

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_GZ_HARMONIC_VERSION=0.244.12-3jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        libasio-dev \
        libeigen3-dev \
        libtinyxml2-9 \
        netcat-openbsd \
        procps \
        python3-yaml \
        ros-humble-eigen3-cmake-module \
        ros-humble-foxglove-bridge \
        ros-humble-joint-state-publisher \
        ros-humble-rosbag2-storage-mcap \
        ros-humble-robot-state-publisher \
    && curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && . /etc/os-release \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable ${UBUNTU_CODENAME} main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-humble-ros-gzharmonic-bridge="${ROS_GZ_HARMONIC_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/ /usr/local/
COPY --from=builder /opt/drn_ws/install/ /opt/drn_ws/install/
COPY scripts/docker/project-sdk.py /usr/local/bin/drn-project
COPY scripts/docker/evidence.py /usr/local/bin/drn-evidence
COPY scripts/docker/ros-environment.sh /usr/local/bin/drn-ros-environment
COPY scripts/docker/ros-entrypoint.sh /usr/local/bin/drn-ros-entrypoint
COPY scripts/docker/ros-healthcheck.sh /usr/local/bin/drn-ros-healthcheck
COPY scripts/docker/sensor-smoke.py /usr/local/bin/drn-sensor-smoke
COPY scripts/docker/vision-odometry-smoke.py /usr/local/bin/drn-vision-odometry-smoke
COPY scripts/docker/smoke-test.sh /usr/local/bin/drn-smoke-test

RUN sed -i 's/\r$//' \
        /usr/local/bin/drn-evidence \
        /usr/local/bin/drn-project \
        /usr/local/bin/drn-sensor-smoke \
        /usr/local/bin/drn-vision-odometry-smoke \
    && chmod 0755 \
        /usr/local/bin/drn-evidence \
        /usr/local/bin/drn-project \
        /usr/local/bin/drn-ros-environment \
        /usr/local/bin/drn-ros-entrypoint \
        /usr/local/bin/drn-ros-healthcheck \
        /usr/local/bin/drn-sensor-smoke \
        /usr/local/bin/drn-vision-odometry-smoke \
        /usr/local/bin/drn-smoke-test \
    && ldconfig

ENV ROS_DISTRO=humble
ENV ROS_DOMAIN_ID=0
ENV XRCE_PORT=8888
ENV FOXGLOVE_PORT=8765
ENV ODOMETRY_TOPIC=/fmu/out/vehicle_odometry
ENV DRN_PROFILE=x500-basic
ENV DRN_AIRFRAME=x500
ENV DRN_PROFILE_CAPABILITIES=""
ENV DRN_SIM_MODEL_NAME=x500_0
ENV PX4_GZ_WORLD=default

ENTRYPOINT ["/usr/local/bin/drn-ros-entrypoint"]
